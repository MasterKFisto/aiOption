{
  "name": "aioption",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI crypto options trading web application — monorepo",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present dev",
    "dev:server": "pnpm --filter @aioption/server dev",
    "build": "pnpm --recursive --if-present build",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "test": "pnpm --recursive --if-present test",
    "lint": "pnpm --recursive --if-present lint",
    "clean": "pnpm --recursive --if-present clean"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
