generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

enum WalletType {
  PAPER
  METAMASK
  SMART_WALLET
}

enum ChainEnum {
  ETHEREUM
  POLYGON
  ARBITRUM
  PAPER
}

enum WalletStatus {
  ACTIVE
  INACTIVE
}

enum DepositStatus {
  COMPLETED
  PENDING
  FAILED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum OrderStatus {
  PENDING
  RISK_APPROVED
  RISK_REJECTED
  SUBMITTED
  FILLED
  CANCELED
  FAILED
}

enum PositionStatus {
  OPEN
  CLOSED
  EXPIRED
  CANCELED
}

enum LedgerEventType {
  DEPOSIT
  WITHDRAWAL_REQUEST
  WITHDRAWAL_COMPLETE
  OPTION_PREMIUM_PAID
  OPTION_PREMIUM_RECEIVED
  TRADING_FEE
  PLATFORM_FEE
  OPTION_SETTLEMENT_PROFIT
  OPTION_SETTLEMENT_LOSS
  ADJUSTMENT
}

enum AccountType {
  BALANCE
  LOCKED
  PENDING
}
model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  passwordHash       String
  status             UserStatus   @default(ACTIVE)
  jurisdiction       String       @default("US")
  riskAcknowledgedAt DateTime?
  kycStatus          KycStatus    @default(NONE)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  wallets          Wallet[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]
  ledgerAccounts   LedgerAccount[]
  ledgerEntries    LedgerEntry[]
  tradingSettings  TradingSettings?
  aiSignals        AiSignal[]
  riskEvents       RiskEvent[]
  orders           Order[]
  positions        Position[]
  auditLogs        AuditLog[]
}

model Wallet {
  id            String       @id @default(uuid())
  userId        String
  walletType    WalletType   @default(PAPER)
  walletAddress String?
  chain         ChainEnum    @default(PAPER)
  status        WalletStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user           User             @relation(fields: [userId], references: [id])
  ledgerAccounts LedgerAccount[]
  deposits       Deposit[]
  withdrawals    Withdrawal[]
}

model LedgerAccount {
  id          String      @id @default(uuid())
  userId      String
  walletId    String
  asset       String
  accountType AccountType @default(BALANCE)
  createdAt   DateTime    @default(now())

  user    User          @relation(fields: [userId], references: [id])
  wallet  Wallet        @relation(fields: [walletId], references: [id])
  entries LedgerEntry[]
}
model LedgerEntry {
  id            String          @id @default(uuid())
  userId        String
  accountId     String
  asset         String
  debit         Decimal         @default(0) @db.Decimal(18, 6)
  credit        Decimal         @default(0) @db.Decimal(18, 6)
  eventType     LedgerEventType
  referenceType String
  referenceId   String
  metadata      Json            @default("{}")
  createdAt     DateTime        @default(now())

  user    User          @relation(fields: [userId], references: [id])
  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([referenceType, referenceId])
}

model TradingSettings {
  id                  String   @id @default(uuid())
  userId              String   @unique
  autoTradingEnabled  Boolean  @default(false)
  maxTradeSizeUsd     Decimal  @default(10) @db.Decimal(18, 6)
  dailyLossLimitUsd   Decimal  @default(20) @db.Decimal(18, 6)
  weeklyLossLimitUsd  Decimal  @default(50) @db.Decimal(18, 6)
  maxOpenPositions    Int      @default(3)
  reinvestProfits     Boolean  @default(true)
  allowedAssets       String[] @default(["USDC", "ETH", "BTC"])
  allowedOptionTypes  String[] @default(["CALL", "PUT"])
  minAiConfidence     Decimal  @default(0.6) @db.Decimal(4, 2)
  maxSlippagePercent  Decimal  @default(2) @db.Decimal(5, 2)
  maxSpreadPercent    Decimal  @default(5) @db.Decimal(5, 2)
  stopLossPercent     Decimal  @default(50) @db.Decimal(5, 2)
  takeProfitPercent   Decimal  @default(100) @db.Decimal(5, 2)
  continuousTrading   Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AiSignal {
  id             String    @id @default(uuid())
  userId         String
  asset          String
  direction      String
  confidence     Decimal   @db.Decimal(4, 2)
  expectedReturn Decimal   @db.Decimal(6, 4)
  riskScore      Decimal   @db.Decimal(4, 2)
  strategy       String
  optionType     String
  expiryDays     Int
  strikeType     String
  maxPremiumUsd  Decimal   @db.Decimal(12, 6)
  reason         String[]
  executed       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id])
  riskEvents RiskEvent[]

  @@index([userId, createdAt])
}

model RiskEvent {
  id        String   @id @default(uuid())
  userId    String
  signalId  String
  checkName String
  passed    Boolean
  reason    String
  metadata  Json     @default("{}")
  createdAt DateTime @default(now())

  user   User     @relation(fields: [userId], references: [id])
  signal AiSignal @relation(fields: [signalId], references: [id])

  @@index([userId, createdAt])
  @@index([signalId])
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  signalId         String?
  venue            String      @default("PAPER")
  asset            String
  optionType       String
  side             String
  strikeType       String
  expiryDays       Int
  premiumLimitUsd  Decimal     @db.Decimal(12, 6)
  actualPremiumUsd Decimal?    @db.Decimal(12, 6)
  quantity         Int         @default(1)
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  position Position?

  @@index([userId, createdAt])
}

model Position {
  id               String         @id @default(uuid())
  userId           String
  orderId          String         @unique
  asset            String
  optionType       String
  status           PositionStatus @default(OPEN)
  strikePrice      Decimal        @db.Decimal(18, 6)
  entryPremiumUsd  Decimal        @db.Decimal(12, 6)
  currentValueUsd  Decimal        @default(0) @db.Decimal(12, 6)
  unrealizedPnlUsd Decimal        @default(0) @db.Decimal(12, 6)
  realizedPnlUsd   Decimal        @default(0) @db.Decimal(12, 6)
  expiresAt        DateTime
  openedAt         DateTime       @default(now())
  closedAt         DateTime?

  user  User  @relation(fields: [userId], references: [id])
  order Order @relation(fields: [orderId], references: [id])

  @@index([userId, status])
}

model Deposit {
  id        String        @id @default(uuid())
  userId    String
  walletId  String
  asset     String
  amount    Decimal       @db.Decimal(18, 6)
  status    DepositStatus @default(COMPLETED)
  createdAt DateTime      @default(now())

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([userId, createdAt])
}

model Withdrawal {
  id                 String           @id @default(uuid())
  userId             String
  walletId           String
  asset              String
  amount             Decimal          @db.Decimal(18, 6)
  destinationAddress String
  status             WithdrawalStatus @default(REQUESTED)
  approvedBy         String?
  rejectedBy         String?
  reason             String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  wallet Wallet @relation(fields: [walletId], references: [id])

  @@index([userId, createdAt])
  @@index([status])
}

model MarketSnapshot {
  id         String   @id @default(uuid())
  asset      String
  spotPrice  Decimal  @db.Decimal(18, 6)
  volatility Decimal  @db.Decimal(6, 4)
  timestamp  DateTime @default(now())

  @@unique([asset, timestamp])
  @@index([asset, timestamp])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  resource   String
  resourceId String
  details    Json     @default("{}")
  ipAddress  String   @default("0.0.0.0")
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([action, createdAt])
}