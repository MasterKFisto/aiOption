# ===========================================
# aioption — environment variables
# Copy to .env and adjust values as needed.
# Never commit .env files containing real secrets.
# ===========================================

# Trading mode: PAPER | TESTNET | LIVE
TRADING_MODE=PAPER

# SQLite trading database path (absolute, or relative to the repository root)
DB_PATH=data/trading.db

# Base currency used for balances and P/L accounting
BASE_CURRENCY=USDC

# Fixed trade size in USD for each option position
FIXED_TRADE_SIZE_USD=10

# Maximum number of concurrently open positions
MAX_OPEN_POSITIONS=5

# Daily loss limit as a percentage of account equity
LOSS_LIMIT_PERCENT=40

# HTTP server
HOST=0.0.0.0
PORT=8080

# Logging
LOG_LEVEL=info

# Hostnames the API may be addressed as (DNS-rebinding protection). Requests
# with any other Host header are rejected with 403.
ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Comma-separated list of allowed browser origins (CORS). Use * to allow all.
# State-changing requests (POST/PUT/DELETE) from any other browser origin are
# rejected with 403 (CSRF protection); non-browser clients are unaffected.
# Loopback aliases are equivalent: http://localhost:5173 also allows
# http://127.0.0.1:5173 and http://[::1]:5173 (same scheme + port only).
CORS_ORIGIN=http://localhost:5173

# Live market data (public source)
MARKET_SYMBOL=BTC/USDC
FALLBACK_MARKET_SYMBOL=BTC/USDT
MARKET_POLL_INTERVAL_MS=3000

# Tron USDC (TRC20)
# SIMULATED (default) | SHASTA | NILE | MAINNET
TRON_MODE=SIMULATED
# Environment DEFAULT for the USDC trade/deposit address. Phase 6.5.1: the
# address can be updated from the UI (Classic Options → Trade Address); the
# database value (app_settings.usdc_trade_address) overrides this one.
TRON_DEPOSIT_ADDRESS=
TRON_HOT_WALLET_ADDRESS=
TRON_USDC_CONTRACT_ADDRESS=
TRON_GRID_API_KEY=
TRON_REQUIRED_CONFIRMATIONS=12
# Real Tron withdrawals are OFF by default. Only enable with a properly
# configured hot wallet. NOTE: the hot wallet must hold TRX for energy/bandwidth fees.
ENABLE_LIVE_TRON_WITHDRAWALS=false
# SERVER ONLY — never committed, never exposed to the frontend.
# Only read when TRON_MODE is live AND ENABLE_LIVE_TRON_WITHDRAWALS=true.
TRON_HOT_WALLET_PRIVATE_KEY=

# Binary options (internal-ledger settlement, never on-chain)
BINARY_ENABLED=true
BINARY_LIVE_TRADING_ENABLED=false
BINARY_MIN_STAKE_USD=1
BINARY_MAX_STAKE_USD=50
BINARY_DEFAULT_STAKE_USD=10
BINARY_ALLOWED_DURATIONS_SECONDS=5,10
BINARY_ALLOWED_PAYOUT_RATIOS=0.5,0.6,0.7,0.8,0.9
BINARY_MAX_OPEN_CONTRACTS=3
BINARY_MAX_PRICE_STALE_MS=3000
BINARY_SETTLEMENT_SOURCE=INTERNAL_MARKET_FEED
BINARY_SETTLEMENT_INTERVAL_MS=250

# AI binary trading (safe defaults)
AI_BINARY_ENABLED=false
AI_BINARY_MODE=SIGNAL_ONLY
AI_BINARY_ASSET=BTC/USDC
AI_BINARY_STAKE_USD=10
AI_BINARY_DURATION_SECONDS=10
AI_BINARY_PAYOUT_RATIO=0.8
AI_BINARY_MIN_CONFIDENCE=0.65
AI_BINARY_EVALUATION_INTERVAL_MS=1000
AI_BINARY_MAX_OPEN_CONTRACTS=1
AI_BINARY_MIN_TIME_BETWEEN_TRADES_MS=10000
AI_BINARY_COOLDOWN_AFTER_LOSS_MS=30000
AI_BINARY_MAX_CONSECUTIVE_LOSSES=3
AI_BINARY_MAX_SESSION_LOSS_USD=20
AI_BINARY_MAX_TRADES_PER_HOUR=30
AI_BINARY_REQUIRE_SIGNAL_PERSISTENCE_TICKS=3
AI_BINARY_MAX_PRICE_STALE_MS=3000
AI_BINARY_LIVE_AUTO_TRADING_ENABLED=false

# Classic short-duration options (Phase 6.4 / 6.5.1)
# Default 10 minutes, hard maximum 60 minutes. Every allowed duration must be
# <= OPTION_MAX_DURATION_SECONDS and the default must be in the allowed list.
# Classic settings saved from the UI (stake, duration, loss limits) are stored
# in the database (app_settings / account) and override these defaults.
OPTION_MAX_DURATION_SECONDS=3600
OPTION_DEFAULT_DURATION_SECONDS=600
OPTION_ALLOWED_DURATIONS_SECONDS=60,180,300,600,900,1800,3600
OPTION_SETTLEMENT_GRACE_MS=5000
OPTION_MAX_PRICE_STALE_MS=3000
MAX_OPTION_STAKE_USD=100
MIN_OPTION_STAKE_USD=1
DEFAULT_OPTION_STAKE_USD=10
DAILY_LOSS_LIMIT_PERCENT=40
# Total (all-time) loss limit as % of starting equity; 0 = disabled.
TOTAL_LOSS_LIMIT_PERCENT=0

# Tron withdrawal fee handling (Phase 6.4)
TRON_WITHDRAWAL_FEE_POLICY=HOT_WALLET_PAYS
TRON_WITHDRAWAL_FEE_ESTIMATE_TRX=30
TRON_USD_TRX_PRICE=0.12
TRON_MIN_TRX_BALANCE_FOR_WITHDRAWAL=50
ALLOW_WITHDRAWAL_WHEN_FEE_INSUFFICIENT=false

# AI binary profit target (Phase 6.4)
AI_BINARY_PROFIT_TARGET_ENABLED=true
AI_BINARY_PROFIT_TARGET_USD=50
AI_BINARY_DAILY_PROFIT_LIMIT_PERCENT=20
AI_BINARY_STOP_ON_PROFIT_TARGET=true

# Binary session gain limit (Phase 6.5)
BINARY_SESSION_GAIN_LIMIT_ENABLED=true
BINARY_MAX_SESSION_GAIN_USDC=50
BINARY_MAX_SESSION_GAIN_PERCENT=0
BINARY_SESSION_RESET_ON_START=true

# TRX fee wallet deposits (Phase 6.5)
# Environment default; a UI-saved value (app_settings.trx_fee_wallet_address) overrides it.
TRON_FEE_WALLET_ADDRESS=
TRON_ACCEPT_TRX_DEPOSITS=true
TRON_MIN_TRX_FEE_RESERVE=50
TRON_FEE_DEPOSIT_REQUIRED_CONFIRMATIONS=20

