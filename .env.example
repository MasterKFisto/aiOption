# ===========================================
# AI Crypto Options MVP - Environment Variables
# ===========================================
# IMPORTANT: Copy this file to .env and adjust values for your environment.
# Never commit .env files containing real secrets.

# --- General ---
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# --- Database ---
DATABASE_URL=postgresql://app:app@localhost:5432/ai_options
DATABASE_URL_TEST=postgresql://app:app@localhost:5432/ai_options_test

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT Authentication ---
JWT_SECRET=change_me_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# --- Admin ---
ADMIN_EMAIL=admin@example.com

# --- Trading Engine ---
TRADING_LOOP_ENABLED=true
TRADING_LOOP_INTERVAL_MS=30000
PAPER_TRADING=true
LIVE_TRADING_ENABLED=false

# --- Trading Parameters ---
DEFAULT_MAX_TRADE_USD=10
DEFAULT_DAILY_LOSS_LIMIT_USD=20
DEFAULT_WEEKLY_LOSS_LIMIT_USD=50
DEFAULT_MAX_OPEN_POSITIONS=3

# --- Asset Configuration ---
SUPPORTED_ASSETS=USDC,ETH,BTC
BASE_ASSET=USDC

# --- Wallet Mode ---
# Options: PAPER | METAMASK | SMART_WALLET
WALLET_MODE=PAPER
METAMASK_ENABLED=false
SMART_WALLET_ENABLED=false

# --- Blockchain RPC (Optional - not required for paper trading) ---
ALCHEMY_RPC_URL=
INFURA_RPC_URL=

# --- Options Venue ---
# Options: PAPER | TESTNET | LIVE
OPTIONS_VENUE_MODE=PAPER

# --- AI Engine ---
# Options: MOCK | OPENAI | CUSTOM
AI_ENGINE_MODE=MOCK
OPENAI_API_KEY=

# --- Logging ---
LOG_LEVEL=info
LOG_PRETTY=true

# --- CORS ---
CORS_ORIGIN=http://localhost:5173

# --- Rate Limiting ---
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000