# ===========================================
# aioption — environment variables
# Copy to .env and adjust values as needed.
# Never commit .env files containing real secrets.
# ===========================================

# Trading mode: PAPER | TESTNET | LIVE
TRADING_MODE=PAPER

# SQLite trading database path (absolute, or relative to the repository root)
DB_PATH=data/trading.db

# Base currency used for balances and P/L accounting
BASE_CURRENCY=USDC

# Fixed trade size in USD for each option position
FIXED_TRADE_SIZE_USD=10

# Maximum number of concurrently open positions
MAX_OPEN_POSITIONS=5

# Daily loss limit as a percentage of account equity
LOSS_LIMIT_PERCENT=5

# HTTP server
HOST=0.0.0.0
PORT=3001

# Logging
LOG_LEVEL=info
