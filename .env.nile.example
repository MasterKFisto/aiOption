# ===========================================
# aioption — NILE TESTNET environment (Phase 7.2)
# Copy to .env on the ECS host (or locally for the local rehearsal):
#   cp .env.nile.example .env && chmod 600 .env
# Never commit .env — it is git-ignored. NO REAL FUNDS: MODE=TESTNET is
# startup-guaranteed to run on a Tron test network (Nile here).
# ===========================================

NODE_ENV=production
MODE=TESTNET
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=info

# The Fastify backend also serves the built React UI (relative to repo root).
WEB_DIST_DIR=apps/web/dist

# --------------------- Public entry point (Caddy) ----------------------
# Domain that resolves (DNS A record) to the ECS public IP. Caddy obtains a
# Let's Encrypt certificate automatically for it. For local testing use
# PUBLIC_DOMAIN=localhost (Caddy then uses its internal CA instead of ACME).
PUBLIC_DOMAIN=yourdomain.com

# Whole-site basic auth (personal, single-user app). Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YourStrongPassword'
# Put ONLY the generated bcrypt hash here — never the plaintext password.
# IMPORTANT: bcrypt hashes contain '$' — wrap the value in SINGLE QUOTES so
# Docker Compose does not mangle it during variable expansion:
#   BASIC_AUTH_HASH='$2a$14$…'
BASIC_AUTH_USER=admin
BASIC_AUTH_HASH=''

# ------------------------- Security guards -----------------------------
# The app rejects requests whose Host header is not listed here (DNS-rebinding
# guard). MUST include the public domain — Caddy forwards the original Host.
ALLOWED_HOSTS=yourdomain.com,localhost,127.0.0.1,::1
# UI and API are same-origin through Caddy, so no CORS entry is required for
# the public domain. Keep the local default for the SSH-tunnel/debug path.
CORS_ORIGIN=http://localhost:8080

# ------------------------------ Database --------------------------------
DB_PATH=data/trading.db
BASE_CURRENCY=USDT
FIXED_TRADE_SIZE_USD=10
MAX_OPEN_POSITIONS=0
LOSS_LIMIT_PERCENT=40
DAILY_LOSS_LIMIT_PERCENT=40
TOTAL_LOSS_LIMIT_PERCENT=0

# --------------------- Live market data (read-only) ---------------------
MARKET_SYMBOL=BTC/USDT
FALLBACK_MARKET_SYMBOL=BTC/USD
MARKET_POLL_INTERVAL_MS=3000

# --------------------------- Tron NILE TESTNET --------------------------
# Official endpoints (verified against developers.tron.network/docs/networks):
#   HTTP API (TronGrid): https://nile.trongrid.io
#   Block explorer:      https://nile.tronscan.org   (nileex.io is the website)
TRON_MODE=NILE
TRON_NETWORK_NAME=Nile Testnet
TRON_RPC_URL=https://nile.trongrid.io
TRON_EXPLORER_URL=https://nile.tronscan.org

# Nile testnet deposit address (get test TRX from the Nile faucet).
TRON_DEPOSIT_ADDRESS=
# Hot wallet stays empty on the testnet — live withdrawals are disabled.
TRON_HOT_WALLET_ADDRESS=
TRON_HOT_WALLET_PRIVATE_KEY=
# There is NO official USDT on Nile — deploy/use a test TRC20 token (the UI
# labels it USDT-TEST, "Tether USD Test", 6 decimals). NEVER set the mainnet
# USDT contract here.
TRON_USDT_CONTRACT_ADDRESS=
TRON_GRID_API_KEY=
TRON_REQUIRED_CONFIRMATIONS=20

# TRX fee wallet (Nile test TRX only)
TRON_FEE_WALLET_ADDRESS=
TRON_ACCEPT_TRX_DEPOSITS=true
TRON_MIN_TRX_FEE_RESERVE=50
TRON_FEE_DEPOSIT_REQUIRED_CONFIRMATIONS=20

# --------------------------- Live switches: OFF -------------------------
ENABLE_LIVE_TRON_WITHDRAWALS=false
BINARY_LIVE_TRADING_ENABLED=false
AI_BINARY_LIVE_AUTO_TRADING_ENABLED=false
LIVE_MODE_CONFIRM=
LIVE_WITHDRAWALS_CONFIRM=

# Admin/maintenance API (UAT reset over HTTP). 404 unless explicitly enabled;
# the CLI reset works regardless. Keep disabled behind the public domain.
ENABLE_ADMIN_API=false

# ------------------------------ Binary options --------------------------
BINARY_ENABLED=true
BINARY_MIN_STAKE_USD=1
BINARY_MAX_STAKE_USD=50
BINARY_DEFAULT_STAKE_USD=10
BINARY_ALLOWED_DURATIONS_SECONDS=5,10
BINARY_ALLOWED_PAYOUT_RATIOS=0.5,0.6,0.7,0.8,0.9
BINARY_MAX_OPEN_CONTRACTS=0
BINARY_MAX_PRICE_STALE_MS=8000
BINARY_SETTLEMENT_SOURCE=INTERNAL_MARKET_FEED
BINARY_SETTLEMENT_INTERVAL_MS=250
BINARY_SHOW_ESTIMATED_UNREALIZED_PNL=false
BINARY_SESSION_GAIN_LIMIT_ENABLED=true
BINARY_MAX_SESSION_GAIN_USDT=50
BINARY_MAX_SESSION_GAIN_PERCENT=0
BINARY_SESSION_RESET_ON_START=true

# ------------------------------- AI binary ------------------------------
AI_BINARY_ENABLED=false
AI_BINARY_MODE=SIGNAL_ONLY
AI_BINARY_ASSET=BTC/USDT
AI_BINARY_STAKE_USD=10
AI_BINARY_DURATION_SECONDS=10
AI_BINARY_PAYOUT_RATIO=0.8
AI_BINARY_MIN_CONFIDENCE=0.65
AI_BINARY_EVALUATION_INTERVAL_MS=1000
AI_BINARY_MAX_OPEN_CONTRACTS=0
AI_BINARY_MIN_TIME_BETWEEN_TRADES_MS=10000
AI_BINARY_COOLDOWN_AFTER_LOSS_MS=30000
AI_BINARY_MAX_CONSECUTIVE_LOSSES=3
AI_BINARY_MAX_SESSION_LOSS_USD=20
AI_BINARY_MAX_TRADES_PER_HOUR=0
AI_BINARY_REQUIRE_SIGNAL_PERSISTENCE_TICKS=3
AI_BINARY_MAX_PRICE_STALE_MS=8000
AI_BINARY_PROFIT_TARGET_ENABLED=true
AI_BINARY_PROFIT_TARGET_USD=50
AI_BINARY_DAILY_PROFIT_LIMIT_PERCENT=20
AI_BINARY_STOP_ON_PROFIT_TARGET=true

# ---------------------------- Classic options ---------------------------
OPTION_MAX_DURATION_SECONDS=3600
OPTION_DEFAULT_DURATION_SECONDS=600
OPTION_ALLOWED_DURATIONS_SECONDS=60,180,300,600,900,1800,3600
OPTION_SETTLEMENT_GRACE_MS=5000
OPTION_MAX_PRICE_STALE_MS=8000
MAX_OPTION_STAKE_USD=100
MIN_OPTION_STAKE_USD=1
DEFAULT_OPTION_STAKE_USD=10
CLASSIC_AI_RSI_PERIOD=14
CLASSIC_AI_RSI_OVERBOUGHT=70
CLASSIC_AI_RSI_OVERSOLD=30
CLASSIC_AI_REQUIRE_NEUTRAL_COOLDOWN=true
CLASSIC_MAX_CONSECUTIVE_SAME_DIRECTION=3
CLASSIC_COOLDOWN_AFTER_MAX_CONSECUTIVE_MS=300000

# ------------------------- Withdrawal fee handling ----------------------
TRON_WITHDRAWAL_FEE_POLICY=HOT_WALLET_PAYS
TRON_WITHDRAWAL_FEE_ESTIMATE_TRX=30
TRON_USD_TRX_PRICE=0.12
TRON_MIN_TRX_BALANCE_FOR_WITHDRAWAL=50
ALLOW_WITHDRAWAL_WHEN_FEE_INSUFFICIENT=false

# ------------------------- Simulated market engine ----------------------
SIMULATOR_MEAN_REVERSION_STRENGTH=0.05
SIMULATOR_BASE_VOLATILITY=0.002
SIMULATOR_CANDLE_INTERVAL_MS=300000
SIMULATOR_BTC_MEAN_PRICE=60000
